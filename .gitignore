.gradle/
build/
app/build/
local.properties

# Reproducible offline TTS binaries and model assets are downloaded by
# scripts/fetch-offline-tts.sh instead of being committed to git.
.offline-tts-downloads/
app/libs/*.aar
app/src/main/assets/vits-piper-*/

# Firebase Android configuration is supplied to CI through an encrypted secret.
app/google-services.json

# Never commit unencrypted signing keys.
app/bookflow-signing.jks
*.keystore
*.jks
